# Self-Healing API Gateway Configuration
#
# This file defines how the gateway routes requests to upstream services.
# Copy this to gateway.yaml and customize for your services.
#
# Usage:
#   cp gateway.yaml.example gateway.yaml
#   make gateway

server:
  port: 8080  # Gateway listens on this port
  auto_heal: true  # Automatically execute Gemini's healing suggestions (synchronously)
  require_approval: false  # INITIAL state of the human-approval gate; toggle it live from the console (http://localhost:8080/ui) without restarting
                           # to Approve/Reject it in the console at http://localhost:8080/ui
                           # (only applies when auto_heal is also true)
  approval_timeout: 120s   # How long a decision waits for a human verdict before it
                           # expires and the client gets the original error (default 120s)
  healing_budget: 5s   # Hard cap on total healing time per request (LLM + retries + fallback).
                       # With require_approval, the budget starts AFTER approval is granted.
  breaker_threshold: 10  # Consecutive upstream failures before the circuit opens (0 = disabled)
  breaker_reset: 30s     # How long an open circuit fast-fails before admitting one trial

llm:
  provider: gemini                    # Only gemini supported for now
  model: gemini-1.5-pro               # Model to use for healing decisions
  api_key: ${GEMINI_API_KEY}          # From environment variable
  timeout: 2s                         # Max time to wait for LLM response
  max_healing_attempts: 3             # Max retries per request before giving up

# Route definitions
# Each route maps an incoming path to an upstream service.
# The request path is appended to the upstream URL as-is.
#
# Example:
#   path: /users
#   upstream: http://user-service:8081
#   GET /users/123 → http://user-service:8081/users/123
#
routes:
  # Demo shop routes (these are the upstream services we built in I1/I2)
  - path: /buy
    upstream: http://localhost:8081     # Storefront service
    fallback: ""                         # Optional fallback URL (empty = no fallback)
    timeout: 10s                         # Max time to wait for upstream
    retries: 3                           # Max automatic retries before LLM healing
    skip_healing: false                  # Enable LLM healing for this route

  - path: /checkout
    upstream: http://localhost:8082     # Checkout service
    fallback: ""
    timeout: 5s
    retries: 3
    skip_healing: false

  - path: /pay
    upstream: http://localhost:8083     # Payment service
    fallback: ""
    timeout: 3s
    retries: 3
    skip_healing: false

  # Example: skip healing for health checks
  # - path: /health
  #   upstream: http://localhost:8091
  #   timeout: 2s
  #   retries: 0
  #   skip_healing: true                # Don't waste LLM calls on health checks
