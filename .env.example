# atlas environment configuration
# Copy to .env and fill in values. .env is gitignored — never commit secrets.

# ---- demo-shop (examples/demo-shop) ----
STOREFRONT_PORT=8080
CHECKOUT_PORT=8081
PAYMENT_PORT=8082
CHECKOUT_URL=http://localhost:8081
PAYMENT_URL=http://localhost:8082

# Chaos knob: extra latency injected into the payment service.
# Any Go duration string: 500ms, 3s, 1m. Set to 0s to disable.
PAYMENT_DELAY=0s

# How long checkout waits for payment before failing the request.
# Go duration string. Default: 2s.
PAYMENT_TIMEOUT=2s

# How long storefront waits for checkout (the user's total budget).
# Should exceed PAYMENT_TIMEOUT — budgets shrink down the chain. Default: 5s.
CHECKOUT_TIMEOUT=5s

# ---- reserved slots (filled in by later increments, documented here as they land) ----
# LLM provider (I13): keys are environment-only, never flags or files
# LLM_PROVIDER=ollama
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# OIDC auth adapter (I7)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# AWS path (I10) — optional, compose-only mode needs none of this
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Observability endpoints (I2/I3) — BYO seam
# OTEL_EXPORTER_OTLP_ENDPOINT=
# PROMETHEUS_URL=
# LOKI_URL=
# TEMPO_URL=
